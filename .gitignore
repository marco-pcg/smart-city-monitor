# ============================================================
# Smart City Monitor — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# ---------- ML model artifacts ----------
# Weights are large and versioned separately (Git LFS or GitHub Releases).
models/*.pth
models/*.pt
models/*.pkl
models/*.joblib
models/*.onnx
models/*.trt
models/*.h5
models/*.ckpt

# Keep small metadata files tracked
!models/*.json

# ---------- Datasets ----------
data/
datasets/
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pkl

# ---------- Training runs / logs ----------
runs/
outputs/
checkpoints/
logs/
*.log
lightning_logs/
wandb/
mlruns/
.mlflow/

# ---------- Notebooks ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Testing / coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ---------- Type checkers / linters ----------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ---------- FastAPI / Uvicorn ----------
*.pid
*.seed
*.pid.lock

# ---------- Docker ----------
.dockerignore
docker-compose.override.yml

# ---------- Environment variables ----------
.env.local
.env.development
.env.production
*.env

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Jupyter / IPython ----------
profile_default/
ipython_config.py

# ---------- Node (if you add a JS frontend later) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Misc ----------
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/
